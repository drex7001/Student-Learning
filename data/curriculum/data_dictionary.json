{
  "entities": [
    {
      "name": "subject",
      "fields": [
        { "name": "id", "type": "string", "description": "Stable subject identifier such as OL-MATH." },
        { "name": "name", "type": "string", "description": "English display name." },
        { "name": "name_si", "type": "string", "description": "Sinhala display name when available." },
        { "name": "default_concept_id", "type": "string", "description": "Default concept used when opening a workflow for the subject." }
      ]
    },
    {
      "name": "concept",
      "fields": [
        { "name": "id", "type": "string", "description": "Globally unique concept identifier." },
        { "name": "subject_id", "type": "string", "description": "Subject that owns the concept." },
        { "name": "name", "type": "string", "description": "English display name." },
        { "name": "name_si", "type": "string", "description": "Sinhala display name when available." },
        { "name": "description", "type": "string" },
        { "name": "description_si", "type": "string" }
      ]
    },
    {
      "name": "student",
      "fields": [
        { "name": "id", "type": "string", "description": "Stable identifier used across Postgres, Neo4j, and the frontend." },
        { "name": "full_name", "type": "string", "description": "Synthetic student display name." },
        { "name": "cohort", "type": "string", "description": "Class or section label." }
      ]
    },
    {
      "name": "assessment",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "student_id", "type": "string" },
        { "name": "assessment_date", "type": "date" },
        { "name": "attempt_number", "type": "integer" }
      ]
    },
    {
      "name": "question",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "concept_id", "type": "string" },
        { "name": "prompt", "type": "string" },
        { "name": "score_max", "type": "float" }
      ]
    },
    {
      "name": "question_result",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "assessment_id", "type": "string" },
        { "name": "question_id", "type": "string" },
        { "name": "concept_id", "type": "string" },
        { "name": "score_obtained", "type": "float" },
        { "name": "score_max", "type": "float" }
      ]
    },
    {
      "name": "concept_score",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "student_id", "type": "string" },
        { "name": "assessment_id", "type": "string" },
        { "name": "concept_id", "type": "string" },
        { "name": "mastery_score", "type": "float", "description": "Normalized 0.0-1.0 mastery." },
        { "name": "confidence", "type": "float", "description": "Derived from question coverage in the latest assessment." },
        { "name": "computed_at", "type": "datetime" }
      ]
    },
    {
      "name": "quiz_question",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "subject_id", "type": "string" },
        { "name": "concept_id", "type": "string" },
        { "name": "prompt", "type": "string" },
        { "name": "prompt_si", "type": "string", "description": "Sinhala prompt in subject quiz bank files when available; English subject omits this." },
        { "name": "options_json", "type": "json-string" },
        { "name": "options_si", "type": "array", "description": "Sinhala option text in subject quiz bank files when available; not stored in PostgreSQL." },
        { "name": "correct_option_index", "type": "integer" },
        { "name": "explanation", "type": "string" },
        { "name": "explanation_si", "type": "string", "description": "Sinhala explanation in subject quiz bank files when available; not stored in PostgreSQL." },
        { "name": "difficulty", "type": "integer" }
      ]
    },
    {
      "name": "quiz_attempt",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "student_id", "type": "string" },
        { "name": "subject_id", "type": "string" },
        { "name": "concept_ids_json", "type": "json-string" },
        { "name": "question_ids_json", "type": "json-string" },
        { "name": "status", "type": "string" },
        { "name": "started_at", "type": "datetime" },
        { "name": "submitted_at", "type": "datetime" }
      ]
    },
    {
      "name": "quiz_answer",
      "fields": [
        { "name": "id", "type": "string" },
        { "name": "attempt_id", "type": "string" },
        { "name": "question_id", "type": "string" },
        { "name": "concept_id", "type": "string" },
        { "name": "selected_option_index", "type": "integer" },
        { "name": "is_correct", "type": "integer" },
        { "name": "score_obtained", "type": "float" },
        { "name": "score_max", "type": "float" }
      ]
    }
  ],
  "aggregation_rule": {
    "description": "Concept mastery is the weighted mean of question percentages for all questions mapped to a concept in an assessment.",
    "formula": "mastery_score = sum(score_obtained) / sum(score_max)",
    "confidence_formula": "confidence = min(0.95, answered_question_count / mapped_question_count)"
  },
  "missing_data_policy": {
    "default_confidence": 0.35,
    "default_mastery": 0.5,
    "behavior": "Missing concept observations remain diagnosable but are ranked below observed weak concepts with higher certainty."
  }
}
